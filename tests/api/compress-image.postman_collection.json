              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('officer from Org B denied upload to Org A', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
