          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin uploads normalized EXIF-stripped WebP', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.bucket).to.equal('org-media');",
                  "  pm.expect(body.mimeType).to.equal('image/webp');",
                  "  pm.expect(body.exifStripped).to.equal(true);",
                  "  pm.expect(body.sizeBytes).to.be.above(0);",
                  "  pm.expect(body.sizeBytes).to.be.at.most(5242880);",
                  "  pm.expect(body.path).to.match(/^orgs\\/.+\\/logo\\/.+\\.webp$/);",
                  "  pm.expect(body.publicUrl).to.match(/^https?:\\/\\//);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
