{
  "info": {
    "name": "MyCCS compress-image Edge Function API (spec-04)",
    "_postman_id": "4b8c1d2e-9a7f-4e3c-8b1a-040404040404",
    "description": "End-to-end API security and functional verification for POST /functions/v1/compress-image covering CORS preflight, JWT claim & user verification, 3-role RBAC + cross-org scoping, MIME/magic-byte & 5 MiB size enforcement, and EXIF-stripped WebP uploads.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "SUPABASE_URL", "value": "" },
    { "key": "SUPABASE_PUBLISHABLE_KEY", "value": "" },
    { "key": "ALLOWED_ORIGIN", "value": "" },
    { "key": "STUDENT_JWT", "value": "" },
    { "key": "OFFICER_A_JWT", "value": "" },
    { "key": "OFFICER_B_JWT", "value": "" },
    { "key": "ADMIN_JWT", "value": "" },
    { "key": "ORG_A_ID", "value": "" },
    { "key": "VALID_PNG_PATH", "value": "" },
    { "key": "OVERSIZED_FILE_PATH", "value": "" },
    { "key": "SPOOFED_SVG_PATH", "value": "" }
  ],
  "item": [
    {
      "name": "CORS & Auth (JWT)",
      "item": [
        {
          "name": "[cors] OPTIONS disallowed origin -> 403",
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "https://evil.example.com" },
              { "key": "Access-Control-Request-Method", "value": "POST" }
            ],
            "url": "{{SUPABASE_URL}}/functions/v1/compress-image"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('disallowed OPTIONS origin returns 403 without ACAO', function () {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[anon] POST without Authorization -> 401",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" },
              { "key": "Origin", "value": "{{ALLOWED_ORIGIN}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "organization_id", "value": "{{ORG_A_ID}}", "type": "text" },
                { "key": "kind", "value": "logo", "type": "text" },
                { "key": "file", "type": "file", "src": "{{VALID_PNG_PATH}}" }
              ]
            },
            "url": "{{SUPABASE_URL}}/functions/v1/compress-image"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing Authorization bearer token returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[invalid-jwt] POST malformed JWT -> 401",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" },
              { "key": "Authorization", "value": "Bearer malformed.invalid.jwt" },
              { "key": "Origin", "value": "{{ALLOWED_ORIGIN}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "organization_id", "value": "{{ORG_A_ID}}", "type": "text" },
                { "key": "kind", "value": "logo", "type": "text" },
                { "key": "file", "type": "file", "src": "{{VALID_PNG_PATH}}" }
              ]
            },
            "url": "{{SUPABASE_URL}}/functions/v1/compress-image"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('malformed JWT returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
