    },
    {
      "name": "Authorized WebP Upload",
      "item": [
        {
          "name": "[officer-org-a] POST valid PNG -> 201 WebP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" },
              { "key": "Authorization", "value": "Bearer {{OFFICER_A_JWT}}" },
              { "key": "Origin", "value": "{{ALLOWED_ORIGIN}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "organization_id", "value": "{{ORG_A_ID}}", "type": "text" },
                { "key": "kind", "value": "cover", "type": "text" },
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{VALID_PNG_PATH}}",
                  "contentType": "image/png"
                }
              ]
            },
            "url": "{{SUPABASE_URL}}/functions/v1/compress-image"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('assigned officer uploads normalized EXIF-stripped WebP', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.bucket).to.equal('org-media');",
                  "  pm.expect(body.mimeType).to.equal('image/webp');",
                  "  pm.expect(body.exifStripped).to.equal(true);",
                  "  pm.expect(body.sizeBytes).to.be.above(0);",
                  "  pm.expect(body.sizeBytes).to.be.at.most(5242880);",
                  "  pm.expect(body.path).to.match(/^orgs\\/.+\\/cover\\/.+\\.webp$/);",
                  "  pm.expect(body.publicUrl).to.match(/^https?:\\/\\//);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[admin] POST valid PNG -> 201 WebP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_JWT}}" },
              { "key": "Origin", "value": "{{ALLOWED_ORIGIN}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "organization_id", "value": "{{ORG_A_ID}}", "type": "text" },
                { "key": "kind", "value": "logo", "type": "text" },
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{VALID_PNG_PATH}}",
