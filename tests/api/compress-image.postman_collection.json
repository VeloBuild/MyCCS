                  "type": "file",
                  "src": "{{SPOOFED_SVG_PATH}}",
                  "contentType": "image/jpeg"
                }
              ]
            },
            "url": "{{SUPABASE_URL}}/functions/v1/compress-image"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('spoofed JPEG magic bytes rejected with 415', function () {",
                  "  pm.response.to.have.status(415);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[officer-org-a] POST payload > 5 MiB -> 413",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" },
              { "key": "Authorization", "value": "Bearer {{OFFICER_A_JWT}}" },
