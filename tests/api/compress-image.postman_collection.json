            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "organization_id", "value": "{{ORG_A_ID}}", "type": "text" },
                { "key": "kind", "value": "cover", "type": "text" },
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{OVERSIZED_FILE_PATH}}",
                  "contentType": "image/png"
                }
              ]
            },
            "url": "{{SUPABASE_URL}}/functions/v1/compress-image"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('payload exceeding 5 MiB rejected with 413', function () {",
                  "  pm.response.to.have.status(413);",
