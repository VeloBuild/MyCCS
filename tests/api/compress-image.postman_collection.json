    {
      "name": "Authorized WebP Upload",
      "item": [
        {
          "name": "[officer-org-a] POST EXIF JPEG -> 201 WebP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" },
              { "key": "Authorization", "value": "Bearer {{OFFICER_A_JWT}}" },
              { "key": "Origin", "value": "{{ALLOWED_ORIGIN}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "organization_id", "value": "{{ORG_A_ID}}", "type": "text" },
                { "key": "kind", "value": "cover", "type": "text" },
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{EXIF_JPEG_PATH}}",
                  "contentType": "image/jpeg"
                }
              ]
            },
            "url": "{{SUPABASE_URL}}/functions/v1/compress-image"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('assigned officer uploads normalized EXIF-stripped WebP', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  const orgId = pm.variables.get('ORG_A_ID');",
                  "  const escapedOrgId = orgId.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');",
                  "  const pathRegex = new RegExp(`^orgs/${escapedOrgId}/cover/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\\\.webp$`, 'i');",
                  "  const publicBase = (pm.variables.get('SUPABASE_PUBLIC_URL') || pm.variables.get('SUPABASE_URL')).replace(/\\/+$/, '');",
                  "  pm.expect(body.bucket).to.equal('org-media');",
                  "  pm.expect(body.mimeType).to.equal('image/webp');",
                  "  pm.expect(body.exifStripped).to.equal(true);",
                  "  pm.expect(body.sizeBytes).to.be.above(0);",
                  "  pm.expect(body.sizeBytes).to.be.at.most(5242880);",
                  "  pm.expect(body.path).to.match(pathRegex);",
                  "  pm.expect(body.publicUrl).to.equal(`${publicBase}/storage/v1/object/public/org-media/${body.path}`);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const officerBody = pm.response.json();",
                  "  pm.sendRequest({ url: officerBody.publicUrl, method: 'GET' }, function (err, res) {",
                  "    pm.test('officer uploaded publicUrl serves EXIF-stripped WebP bytes', function () {",
                  "      pm.expect(err).to.not.be.ok;",
                  "      pm.expect(res.code).to.equal(200);",
                  "      pm.expect((res.headers.get('Content-Type') || '').toLowerCase()).to.include('image/webp');",
                  "      const bytes = Buffer.from(res.stream);",
                  "      pm.expect(bytes.length).to.be.above(12);",
                  "      pm.expect(bytes.slice(0, 4).toString('ascii')).to.equal('RIFF');",
                  "      pm.expect(bytes.slice(8, 12).toString('ascii')).to.equal('WEBP');",
                  "      pm.expect(bytes.indexOf(Buffer.from('Exif\\u0000\\u0000', 'ascii'))).to.equal(-1);",
                  "      pm.expect(bytes.indexOf(Buffer.from('EXIF', 'ascii'))).to.equal(-1);",
                  "    });",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
