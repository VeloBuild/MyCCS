            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" },
              { "key": "Authorization", "value": "Bearer malformed.invalid.jwt" },
              { "key": "Origin", "value": "{{ALLOWED_ORIGIN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"certification_id\":\"{{CERTIFICATION_ID}}\",\"csv\":\"email,key_code\\n{{STUDENT_EMAIL}},{{TEST_GMETRIX_KEY_CODE}}\"}"
            },
            "url": "{{SUPABASE_URL}}/functions/v1/import-gmetrix-keys"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('malformed JWT returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[anon] GET my-certification-keys without Authorization -> 401",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" }
            ],
            "url": "{{SUPABASE_URL}}/functions/v1/my-certification-keys"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unauthenticated caller blocked from my-certification-keys with 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
