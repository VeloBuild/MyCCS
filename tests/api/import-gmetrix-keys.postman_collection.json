              { "key": "Origin", "value": "{{ALLOWED_ORIGIN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"certification_id\":\"{{CERTIFICATION_ID}}\",\"csv\":\"email,key_code\\n{{STUDENT_EMAIL}},{{TEST_GMETRIX_KEY_CODE}}\"}"
            },
            "url": "{{SUPABASE_URL}}/functions/v1/import-gmetrix-keys"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing Authorization bearer token returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[invalid-jwt] POST import-gmetrix-keys with malformed JWT -> 401",
          "request": {
