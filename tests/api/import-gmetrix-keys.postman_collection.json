    {
      "name": "CSV & Payload Validation",
      "item": [
        {
          "name": "[admin] POST CSV missing required headers -> 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_JWT}}" },
              { "key": "Origin", "value": "{{ALLOWED_ORIGIN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"certification_id\":\"{{CERTIFICATION_ID}}\",\"csv\":\"student_name,notes\\nJuan,missing headers\"}"
            },
            "url": "{{SUPABASE_URL}}/functions/v1/import-gmetrix-keys"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSV missing required headers rejected with 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error).to.include('email and key_code');",
                  "});"
                ]
              }
            }
          ]
        },
