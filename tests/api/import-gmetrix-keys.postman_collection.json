      ]
    },
    {
      "name": "Authorized Import, Sanitization & Idempotency",
      "item": [
        {
          "name": "[admin] POST partial commit (registered + unregistered + formula-injection) -> 201",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_JWT}}" },
              { "key": "Origin", "value": "{{ALLOWED_ORIGIN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"certification_id\":\"{{CERTIFICATION_ID}}\",\"csv\":\"email,key_code\\n{{STUDENT_EMAIL}},{{TEST_GMETRIX_KEY_CODE}}\\nunregistered.student@lpunetwork.edu.ph,GMX-UNREG-0001\\n=CMD|'/C calc'!A0,GMX-INJECT-0001\"}"
            },
            "url": "{{SUPABASE_URL}}/functions/v1/import-gmetrix-keys"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin partial commit returns 201 with sanitized rejectedRowsCsv and zero raw keys', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const rawText = pm.response.text();",
                  "  const body = pm.response.json();",
                  "  const rawKey = pm.variables.get('TEST_GMETRIX_KEY_CODE');",
                  "  pm.expect(body.certificationId).to.equal(pm.variables.get('CERTIFICATION_ID'));",
                  "  pm.expect(body.totalRows).to.equal(3);",
                  "  pm.expect(body.assignedCount).to.equal(1);",
                  "  pm.expect(body.rejectedCount).to.equal(2);",
                  "  pm.expect(body.rejectedRows).to.have.lengthOf(2);",
                  "  pm.expect(body.rejectedRows.map(function (r) { return r.reason; })).to.deep.equal(['unregistered_student', 'invalid_email']);",
                  "  pm.expect(body.rejectedRowsCsv).to.include('row_number,email,reason');",
                  "  pm.expect(body.rejectedRowsCsv).to.include(\"'=CMD|'/C calc'!A0\");",
                  "  if (rawKey) {",
                  "    pm.expect(rawText).to.not.include(rawKey);",
                  "  }",
                  "  pm.expect(rawText).to.not.include('GMX-UNREG-0001');",
                  "  pm.expect(rawText).to.not.include('GMX-INJECT-0001');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[admin] POST duplicate CSV re-upload -> 201 idempotent (0 newly assigned)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_JWT}}" },
              { "key": "Origin", "value": "{{ALLOWED_ORIGIN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"certification_id\":\"{{CERTIFICATION_ID}}\",\"csv\":\"email,key_code\\n{{STUDENT_EMAIL}},{{TEST_GMETRIX_KEY_CODE}}\\nunregistered.student@lpunetwork.edu.ph,GMX-UNREG-0001\\n=CMD|'/C calc'!A0,GMX-INJECT-0001\"}"
            },
            "url": "{{SUPABASE_URL}}/functions/v1/import-gmetrix-keys"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('duplicate CSV re-upload commits 0 keys and reports duplicate_key_existing', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const rawText = pm.response.text();",
                  "  const body = pm.response.json();",
                  "  const rawKey = pm.variables.get('TEST_GMETRIX_KEY_CODE');",
                  "  pm.expect(body.totalRows).to.equal(3);",
                  "  pm.expect(body.assignedCount).to.equal(0);",
                  "  pm.expect(body.rejectedCount).to.equal(3);",
                  "  pm.expect(body.rejectedRows.map(function (r) { return r.reason; })).to.deep.equal(['duplicate_key_existing', 'unregistered_student', 'invalid_email']);",
                  "  if (rawKey) {",
                  "    pm.expect(rawText).to.not.include(rawKey);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Student My Keys Retrieval",
      "item": [
        {
          "name": "[student] GET my-certification-keys -> 200 caller decrypted key",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" },
              { "key": "Authorization", "value": "Bearer {{STUDENT_JWT}}" }
            ],
            "url": "{{SUPABASE_URL}}/functions/v1/my-certification-keys"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('authenticated student retrieves decrypted assigned key with Cache-Control: no-store', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect((pm.response.headers.get('Cache-Control') || '').toLowerCase()).to.include('no-store');",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.keys).to.be.an('array');",
                  "  const expectedCertId = pm.variables.get('CERTIFICATION_ID');",
                  "  const expectedKey = pm.variables.get('TEST_GMETRIX_KEY_CODE');",
                  "  const match = body.keys.find(function (k) { return k.certificationId === expectedCertId && k.keyCode === expectedKey; });",
                  "  pm.expect(match).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
