    { "key": "ALLOWED_ORIGIN", "value": "" },
    { "key": "STUDENT_JWT", "value": "" },
    { "key": "OFFICER_JWT", "value": "" },
    { "key": "ADMIN_JWT", "value": "" },
    { "key": "CERTIFICATION_ID", "value": "" },
    { "key": "STUDENT_EMAIL", "value": "" },
    { "key": "TEST_GMETRIX_KEY_CODE", "value": "" }
