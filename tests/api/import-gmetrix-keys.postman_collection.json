{
  "info": {
    "name": "MyCCS GMetrix CSV Import & My Keys API (spec-05)",
    "_postman_id": "5c9d2e3f-1b8a-4f4d-9c2b-050505050505",
    "description": "End-to-end API security and functional verification for POST /functions/v1/import-gmetrix-keys and GET /functions/v1/my-certification-keys covering CORS preflight, JWT verification, admin-only RBAC, CSV validation, formula-injection sanitization, partial commit & duplicate idempotency, zero raw key leakage, and caller-scoped key decryption.",
