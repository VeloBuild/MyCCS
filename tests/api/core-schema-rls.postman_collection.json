        {
          "name": "[student] GET announcements -> 200",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{SUPABASE_PUBLISHABLE_KEY}}" },
              { "key": "Authorization", "value": "Bearer {{STUDENT_JWT}}" }
            ],
            "url": "{{SUPABASE_URL}}/rest/v1/announcements?select=*"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('student can read scoped announcements', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const rows = pm.response.json();",
                  "  pm.expect(rows).to.be.an('array');",
                  "  const orgBId = pm.collectionVariables.get('ORG_B_ID');",
                  "  for (const row of rows) {",
                  "    pm.expect(row.deleted_at).to.equal(null);",
                  "    pm.expect(row.expires_at === null || Date.parse(row.expires_at) > Date.now()).to.equal(true);",
                  "    pm.expect(row.global_visibility === true || row.organization_id !== orgBId).to.equal(true);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
