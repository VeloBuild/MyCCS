{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@shared/*": ["../shared/*"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../shared/auth.ts",
    "../shared/gmetrix.ts",
    "../shared/supabase-key-guard.ts",
    "../shared/web-admin.ts",
    "../supabase/functions/_shared/gmetrix-csv.ts"
  ]
}
