#!/usr/bin/env sh

# =============================================================================
# Conventional Commit Message Hook (MyCCS)
# =============================================================================
# Enforces the required commit message format:
#   <type>(<scope>): [SCRUM-<number>] <description>
#   <type>: [SCRUM-<number>] <description>   (scope is optional)
#
# Valid types: feat, fix, hotfix, chore, refactor, docs, test
# Example:    feat(qr): [SCRUM-12] implement offline sqlite attendance queue
# =============================================================================

commit_msg_file="$1"
commit_msg=$(head -n 1 "$commit_msg_file")

# Allow merge commits (auto-generated by Git)
if echo "$commit_msg" | grep -qE "^Merge "; then
  exit 0
fi

pattern="^(feat|fix|hotfix|chore|refactor|docs|test)(\([a-zA-Z0-9_/-]+\))?: \[SCRUM-[0-9]+\] .+$"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "❌ INVALID COMMIT MESSAGE FORMAT"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "  Your message:"
  echo "    \"$commit_msg\""
  echo ""
  echo "  Required format:"
  echo "    <type>(<scope>): [SCRUM-<number>] <description>"
  echo "    <type>: [SCRUM-<number>] <description>"
  echo ""
  echo "  Valid types: feat | fix | hotfix | chore | refactor | docs | test"
  echo ""
  echo "  Examples:"
  echo "    feat(qr): [SCRUM-12] implement offline sqlite attendance queue"
  echo "    feat(web-admin): [SCRUM-19] add gmetrix csv upload"
  echo "    fix(ci): [SCRUM-27] run production deploy on push to main"
  echo "    chore: [SCRUM-20] add initial supabase migration with rls and grants"
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  exit 1
fi

exit 0
