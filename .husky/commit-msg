#!/usr/bin/env sh

# =============================================================================
# Conventional Commit Message Hook
# =============================================================================
# Enforces the required commit message format:
#   <type>(<scope>): [<JIRA-TICKET>] <description>
#
# Valid types: feat, fix, hotfix, chore, refactor
# Example:    feat(auth): [CCS-42] add biometric login support
# =============================================================================

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Allow merge commits (auto-generated by Git)
if echo "$commit_msg" | grep -qE "^Merge "; then
  exit 0
fi

# Regex pattern:
#   ^(feat|fix|hotfix|chore|refactor)  — type (strictly one of 5)
#   \([a-zA-Z0-9_/-]+\)                — scope (alphanumeric, underscores, hyphens, slashes)
#   :                                   — separator
#   \s                                  — space
#   \[[A-Z]+-[0-9]+\]                  — JIRA ticket [PROJECT-123]
#   \s                                  — space
#   .+                                  — description (at least 1 character)
pattern="^(feat|fix|hotfix|chore|refactor)\([a-zA-Z0-9_/-]+\): \[[A-Z]+-[0-9]+\] .+$"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "❌ INVALID COMMIT MESSAGE FORMAT"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "  Your message:"
  echo "    \"$commit_msg\""
  echo ""
  echo "  Required format:"
  echo "    <type>(<scope>): [<JIRA-TICKET>] <description>"
  echo ""
  echo "  Valid types: feat | fix | hotfix | chore | refactor"
  echo ""
  echo "  Examples:"
  echo "    feat(auth): [CCS-42] add biometric login support"
  echo "    fix(api): [CCS-99] resolve token refresh race condition"
  echo "    chore(deps): [CCS-10] bump expo to v57"
  echo "    hotfix(db): [CCS-7] patch migration rollback"
  echo "    refactor(ui): [CCS-15] extract button into shared component"
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  exit 1
fi

exit 0
